# Unified Dockerfile for Kathreftestr
# Includes all services in one container for easy deployment

FROM node:20-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build Next.js app
RUN npm run build

# Production stage
FROM node:20-alpine AS production

# Install runtime dependencies
RUN apk add --no-cache \
    ffmpeg \
    python3 \
    py3-pip \
    supervisor \
    curl \
    bash \
    wget \
    ca-certificates

# Install Python packages
RUN pip3 install --no-cache-dir --break-system-packages \
    yt-dlp \
    streamlink

# Install MediaMTX
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        MEDIAMTX_ARCH="amd64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        MEDIAMTX_ARCH="arm64"; \
    else \
        MEDIAMTX_ARCH="$ARCH"; \
    fi && \
    wget -q https://github.com/bluenviron/mediamtx/releases/download/v1.0.0/mediamtx_v1.0.0_linux_${MEDIAMTX_ARCH}.tar.gz && \
    tar -xzf mediamtx_v1.0.0_linux_${MEDIAMTX_ARCH}.tar.gz && \
    rm mediamtx_v1.0.0_linux_${MEDIAMTX_ARCH}.tar.gz && \
    chmod +x mediamtx && \
    mv mediamtx /usr/local/bin/

WORKDIR /app

# Copy built application from builder
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.js ./
COPY --from=builder /app/*.js ./

# Copy configuration files
COPY mediamtx.yml /etc/mediamtx.yml
COPY supervisord.conf /etc/supervisord.conf

# Create necessary directories
RUN mkdir -p /data /logs /recordings && \
    chmod -R 755 /data /logs /recordings

# Create a non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app /data /logs /recordings

# Health check script
COPY <<'EOF' /healthcheck.sh
#!/bin/sh
curl -f http://localhost:3000/api/health || exit 1
EOF
RUN chmod +x /healthcheck.sh

# Startup script
COPY <<'EOF' /start.sh
#!/bin/sh
set -e

echo "🚀 Starting Kathreftestr..."

# Update yt-dlp on startup
echo "📦 Updating yt-dlp..."
pip3 install --upgrade --no-cache-dir --break-system-packages yt-dlp

# Start MediaMTX in background
echo "📡 Starting MediaMTX..."
mediamtx /etc/mediamtx.yml &

# Wait for MediaMTX
sleep 3

# Start WebSocket server
echo "🔌 Starting WebSocket server..."
node ws-server.js &

# Wait for WebSocket server
sleep 2

# Start Next.js app
echo "🌐 Starting Next.js app..."
exec npm start
EOF
RUN chmod +x /start.sh

# Expose all required ports
EXPOSE 3000 8082 1935 8554 8888 8889 8890

# Set environment variables
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD /healthcheck.sh

# Use supervisor for process management
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisord.conf"]